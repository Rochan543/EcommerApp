# ============================================
# ShopEase Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# On Replit, use the Secrets tab for sensitive values.
# ============================================

# --- Backend (Server) ---

# PostgreSQL connection string (Replit auto-provides this)
DATABASE_URL=

# JWT signing secret for access & refresh tokens (required)
SESSION_SECRET=

# Server port (default: 5000)
PORT=5000

# Node environment: development | production
NODE_ENV=development

# --- Razorpay Payment Gateway (optional, payments disabled without these) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Gemini AI Chatbot (optional, chatbot falls back to static replies without this) ---
GEMINI_API_KEY=

# --- Replit Platform (auto-provided, do not set manually) ---
# REPLIT_DEV_DOMAIN=
# REPLIT_DOMAINS=

# --- Mobile App (Expo) ---
# Set automatically by the expo:dev npm script, do not set manually
# EXPO_PUBLIC_DOMAIN=
